# Environment overrides for server/config.yaml (optional).
# Copy to .env; it is git-ignored. The YAML file stays the main source of truth.
# Nesting uses a double underscore.

# AUDIOLENS_SERVER__HOST=127.0.0.1
# AUDIOLENS_SERVER__PORT=8765
# AUDIOLENS_SERVER__TOKEN=replace_me_with_openssl_rand_hex_16
# AUDIOLENS_SERVER__LOG_LEVEL=INFO

# AUDIOLENS_WHISPER__MODEL=small
# AUDIOLENS_WHISPER__DEVICE=auto
# AUDIOLENS_WHISPER__COMPUTE_TYPE=auto
# AUDIOLENS_WHISPER__CPU_THREADS=4
# AUDIOLENS_WHISPER__BEAM_SIZE=5

# AUDIOLENS_TRANSLATION__ENGINE=none
# AUDIOLENS_TRANSLATION__DEVICE=cpu

# AUDIOLENS_CONFIG=/absolute/path/to/config.yaml
