<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext stays disabled by default. Development uses adb reverse to
         localhost (explicitly allowed below). Phase 6 will add the Tailscale
         path: wss:// via `tailscale serve`, or a domain-specific exception. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">100.66.131.33</domain>
    </domain-config>
</network-security-config>
